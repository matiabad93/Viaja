import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';

const root=new URL('../',import.meta.url);
const get=(path:string)=>readFileSync(new URL(path,root),'utf8');
const sql=get('supabase/migrations/202611030001_collaborative_trip_members.sql');
const client=get('lib/supabase-client.ts');
const app=get('app/page.tsx');
const panel=get('components/trip-team-panel.tsx');
const detail=get('components/trip-detail.tsx');
const dashboard=get('components/trips-dashboard.tsx');

assert.match(sql,/create table if not exists public\.trip_members/);
assert.match(sql,/create table if not exists public\.trip_invitations/);
assert.match(sql,/alter table public\.trip_members enable row level security/);
assert.match(sql,/alter table public\.trip_invitations enable row level security/);
assert.match(sql,/token_hash/);
assert.match(sql,/md5\(p_token\)/);
assert.match(sql,/invite_email<>account_email/);
assert.match(sql,/for update;/);
assert.match(sql,/expires_at<=now\(\)/);
assert.match(sql,/public\.viaja_save_shared_trip/);
assert.match(sql,/p_expected_version/);
assert.match(sql,/version=p_expected_version/);
assert.match(sql,/private\.viaja_trip_role/);
assert.match(sql,/revoke all on function public\.viaja_accept_trip_invite/);
assert.match(sql,/grant execute on function public\.viaja_accept_trip_invite\(text\) to authenticated/);
assert.match(sql,/role='viewer'/);
assert.match(client,/rpc\/viaja_save_shared_trip/);
assert.match(client,/trip_members\?select/);
assert.match(client,/collaboration:/);
assert.match(app,/acceptTripInvite\(invitationToken\)/);
assert.match(app,/saveQueueRef/);
assert.match(app,/TRIP_CONFLICT/);
assert.match(app,/remoteChanges/);
assert.match(app,/refreshActiveTrip/);
assert.match(detail,/TripTeamPanel/);
assert.match(detail,/readOnly/);
assert.match(panel,/createTripInvite/);
assert.match(panel,/revokeTripInvite/);
assert.match(panel,/member\.role/);
assert.match(panel,/72 horas/);
assert.match(dashboard,/EN EQUIPO/);
assert.match(dashboard,/p\.collaboration\.role==='owner'/);
console.log('PASS collaborative trips: permissions, one-use invitations, conflict protection and UI wiring');
