import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {documentPath,formatDocumentBytes,verifyDocumentFile,MAX_TRIP_DOCUMENT_BYTES,SIGNED_URL_TTL_SECONDS} from '../lib/trip-documents.ts';
import {publicTripSnapshot} from '../lib/community-trips.ts';
import type {Plan} from '../lib/travel.ts';

const makeFile=(name:string,bytes:Uint8Array|string,type='application/octet-stream'):File=>{
 const contents:BlobPart[]=typeof bytes==='string'?[bytes]:[bytes as Uint8Array<ArrayBuffer>];
 return Object.assign(new Blob(contents,{type}),{name,lastModified:Date.now(),webkitRelativePath:''}) as File;
};
const pdf=makeFile('Billete de avion.pdf','%PDF-1.7\n1 0 obj\n<<>>\nendobj');
const jpeg=makeFile('Foto.jpg',new Uint8Array([0xff,0xd8,0xff,0xe0,0,0,0,0]));
const png=makeFile('Reserva.PNG',new Uint8Array([137,80,78,71,13,10,26,10,0,0]));
const webp=makeFile('Hotel.webp',new Uint8Array([82,73,70,70,32,0,0,0,87,69,66,80,0]));
const ics=makeFile('calendar.ics','BEGIN:VCALENDAR\r\nVERSION:2.0\r\nEND:VCALENDAR\r\n');
assert.deepEqual((await verifyDocumentFile(pdf)).mime,'application/pdf');
assert.deepEqual((await verifyDocumentFile(jpeg)).mime,'image/jpeg');
assert.deepEqual((await verifyDocumentFile(png)).mime,'image/png');
assert.deepEqual((await verifyDocumentFile(webp)).mime,'image/webp');
assert.deepEqual((await verifyDocumentFile(ics)).mime,'text/calendar');
assert.equal((await verifyDocumentFile(makeFile('reservation.JPEG',new Uint8Array([0xff,0xd8,0xff,0,0])))).extension,'jpg');
await assert.rejects(()=>verifyDocumentFile(makeFile('attack.pdf','<html><script>alert(1)</script></html>')),/contenido no coincide/i);
await assert.rejects(()=>verifyDocumentFile(makeFile('bad.svg','<svg xmlns="http://www.w3.org/2000/svg"/>')),/Formatos permitidos/);
await assert.rejects(()=>verifyDocumentFile(makeFile('empty.pdf','')),/vacío/);
await assert.rejects(()=>verifyDocumentFile(makeFile('huge.pdf',new Uint8Array(MAX_TRIP_DOCUMENT_BYTES+1))),/máximo 10 MB/);
assert.equal(MAX_TRIP_DOCUMENT_BYTES,10485760);
assert.equal(SIGNED_URL_TTL_SECONDS,120);
const a='11111111-1111-4111-8111-111111111111',b='22222222-2222-4222-8222-222222222222';
assert.equal(documentPath(a,b,'application/pdf'),a+'/'+b+'/document.pdf');
assert.equal(documentPath(a,b,'image/jpeg'),a+'/'+b+'/document.jpg');
assert.throws(()=>documentPath('../../etc/passwd',b,'image/png'));
assert.equal(formatDocumentBytes(2048),'2 KB');
const sql=readFileSync(new URL('../supabase/migrations/202611040001_trip_documents_private_storage.sql',import.meta.url),'utf8');
assert.match(sql,/create table if not exists public\.trip_documents/);
assert.match(sql,/references public\.trips\(id\) on delete cascade/);
assert.match(sql,/alter table public\.trip_documents enable row level security/);
assert.match(sql,/viaja_doc_member_read/);
assert.match(sql,/viaja_doc_editor_insert/);
assert.match(sql,/viaja_doc_editor_delete/);
assert.match(sql,/viaja_storage_doc_member_read/);
assert.match(sql,/viaja_storage_doc_editor_insert/);
assert.match(sql,/viaja_storage_doc_editor_delete/);
assert.match(sql,/public=false/);
assert.match(sql,/file_size_limit=10485760/);
assert.match(sql,/private\.viaja_trip_role/);
assert.match(sql,/d\.uploaded_by=\(select auth\.uid\(\)\)/);
assert.ok(!/storage\.objects\s+for update/i.test(sql),'No overwrites');
const plan:Plan={id:a,kind:'draft',createdAt:new Date().toISOString(),
 trip:{destination:'Colmar',origin:'Barcelona',start:'2026-11-27',end:'2026-11-30',travelers:2,budget:0,pace:'Equilibrado',transport:'Sin coche',notes:'',links:'',adjustment:'',sources:[]},
 itinerary:[{id:'d1',title:'Día 1',activities:[{id:'a1',title:'Mercado',description:'Paseo'}]}]};
const publicData=publicTripSnapshot(plan);
assert.ok(!JSON.stringify(publicData).includes('trip_documents'));
const docs=readFileSync(new URL('../lib/trip-documents.ts',import.meta.url),'utf8');
assert.match(docs,/storageRequest/);
assert.match(docs,/getCurrentSession/);
assert.match(docs,/expiresIn:SIGNED_URL_TTL_SECONDS/);
assert.match(docs,/deleteAllTripDocuments/);
assert.doesNotMatch(docs,/service_role|sb_secret_/);
const handler=readFileSync(new URL('../components/logistics/document-list.tsx',import.meta.url),'utf8');
assert.match(handler,/DocumentPreview/);
assert.match(handler,/DocumentUploader/);
assert.match(handler,/ConfirmDialog/);
console.log('PASS documents: signature checks, server RLS contracts, short-lived links, private visibility and safe legacy trip model');
